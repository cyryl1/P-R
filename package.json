{
  "name": "pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @pr-reviewer/server --filter @pr-reviewer/web dev",
    "build": "pnpm -r build",
    "start": "pnpm build && pnpm --filter @pr-reviewer/server start",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @pr-reviewer/shared build && pnpm -r typecheck",
    "review": "pnpm --filter @pr-reviewer/server review"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
